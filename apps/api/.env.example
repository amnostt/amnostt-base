PORT=3000
CORS_ORIGIN=http://localhost:5173
# Required local values. Keep this file secret-free and set real values only in apps/api/.env.
DATABASE_URL=
SEED_MEMBER_PASSWORD=
SEED_ADMIN_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_REGISTRATION_DEFAULT_ROLE=Member
AUTH_REGISTRATION_IP_LIMIT=5
AUTH_REGISTRATION_IP_TTL_SECONDS=60
AUTH_REGISTRATION_EMAIL_LIMIT=3
AUTH_REGISTRATION_EMAIL_TTL_SECONDS=3600
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_IP_TTL_SECONDS=60
AUTH_LOGIN_EMAIL_LIMIT=5
AUTH_LOGIN_EMAIL_TTL_SECONDS=900
