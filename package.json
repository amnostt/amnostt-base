{
  "name": "amnostt-base",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @amnostt/web --filter @amnostt/api run dev",
    "dev:web": "pnpm --filter @amnostt/web dev",
    "dev:web-angular": "pnpm --filter @amnostt/web-angular dev",
    "dev:api": "pnpm --filter @amnostt/api dev",
    "build": "pnpm --parallel --filter @amnostt/web --filter @amnostt/api run build",
    "build:web-angular": "pnpm --filter @amnostt/web-angular build",
    "lint": "pnpm --parallel --filter @amnostt/web --filter @amnostt/api run lint",
    "lint:web-angular": "pnpm --filter @amnostt/web-angular lint",
    "test": "pnpm --filter @amnostt/api test && pnpm --filter @amnostt/web test",
    "test:web-angular": "pnpm --filter @amnostt/web-angular test",
    "test:e2e": "pnpm --filter @amnostt/api test:e2e",
    "db:seed": "pnpm --filter @amnostt/api exec prisma db seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:ps": "docker compose ps",
    "db:logs": "docker compose logs --tail=100 db",
    "prisma:generate": "pnpm --filter @amnostt/api exec prisma generate",
    "db:migrate": "pnpm --filter @amnostt/api exec prisma migrate dev",
    "db:studio": "pnpm --filter @amnostt/api exec prisma studio"
  },
  "packageManager": "pnpm@11.1.2"
}
